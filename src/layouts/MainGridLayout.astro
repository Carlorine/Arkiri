---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import TOC from "@components/widget/TOC.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	/** the profile card belongs on the front pages, not on an article */
	showProfile?: boolean;
	/** article pages keep only the contents: no category or tag panels */
	showWidgets?: boolean;
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	showProfile = true,
	showWidgets = true,
} = Astro.props;

// Reading pages put the table of contents in the page margin.
const hasMargin = headings.length > 0;
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
    <slot slot="head" name="head"></slot>

    {siteConfig.banner.enable && (
        <div class="banner" aria-hidden="true">
            <ImageWrapper
                id="banner"
                alt=""
                class="banner-image"
                src={siteConfig.banner.src}
                position={siteConfig.banner.position}
            />
        </div>
    )}

    <Navbar></Navbar>

    <div class="shell">

        <main id="swup-container" class="transition-swup-fade shell-main">
            <div id="content-wrapper">
                <!-- the overflow guard used to live here; components keep it -->
                <slot></slot>
            </div>
        </main>

        <aside id="page-margin" class:list={["shell-margin", { "is-article-margin": !showWidgets }]}>
            <div id="toc" class="margin-toc" aria-label="Contents">
                <div id="toc-inner-wrapper" class="margin-inner">
                    {hasMargin && <TOC headings={headings}></TOC>}
                </div>
            </div>
            <SideBar class="margin-widgets" headings={headings} showProfile={showProfile} showWidgets={showWidgets}></SideBar>
        </aside>

        <div class="shell-footer"><Footer></Footer></div>
    </div>

    <BackToTop></BackToTop>
</Layout>

<style>
    .shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: start;
        max-width: 1200px;
        margin-inline: auto;
        padding-inline: var(--ef-pad);
    }
    .shell-main {
        min-width: 0;
        width: 100%;
        max-width: 800px;
        margin-inline: auto;
        padding-block: 1.5rem 3rem;
    }
    .shell-footer {
        grid-column: 1 / -1;
        padding-block: 0 3rem;
    }
    .shell-margin {
        min-width: 0;
        padding-block: 1.5rem 3rem;
        border-top: 1px solid var(--ef-rule);
    }
    .margin-toc:not(:has(a)) {
        display: none;
    }
    .margin-toc:has(a) + :global(.margin-widgets) {
        margin-top: 1.6rem;
    }
    .margin-inner {
        max-height: calc(100dvh - var(--site-header-height) - 4rem);
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
    }
    .is-article-margin .margin-inner {
        max-height: calc((100dvh - var(--site-header-height) - 4rem) * 0.6);
    }
    .margin-inner::-webkit-scrollbar { display: none; }
    .banner { border-bottom: 1px solid var(--ef-rule); }
    .banner-image {
        display: block;
        width: 100%;
        height: 26vh;
        min-height: 10rem;
    }
    @media (min-width: 1200px) {
        .shell {
            /* Preserve the home reading column's position. The second track
               fills the remaining viewport, with the margin centred inside. */
            --shell-inset: max(var(--ef-pad), calc((100vw - 1000px) / 2));
            max-width: none;
            margin-inline: var(--shell-inset) 0;
            padding-inline: 0;
            grid-template-columns: minmax(0, 712px) minmax(0, 1fr);
        }
        .shell:has(.post-sheet) {
            /* Grow rightward from the home column's left edge. The margin
               remains centred in the viewport space left beside the article. */
            grid-template-columns: minmax(0, 800px) minmax(0, 1fr);
        }
        .shell-main { padding-bottom: 4rem; }
        .shell-margin {
            width: 240px;
            justify-self: center;
            padding-top: 2rem;
            border-top: 0;
        }
        .shell-margin.is-article-margin {
            position: sticky;
            top: var(--site-header-height);
        }
        .shell-footer {
            margin-inline-end: var(--shell-inset);
            padding-bottom: 4rem;
        }
    }
</style>

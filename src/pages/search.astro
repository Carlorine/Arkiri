---
import ArticleSearch from "@components/Search.svelte";
import UiText from "@components/common/UiText.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
---

<MainGridLayout title={i18n(I18nKey.search)} showProfile={false} showWidgets={false}>
    <section aria-labelledby="search-heading" data-pagefind-ignore>
        <header class="ef-sheet-head">
            <h1 id="search-heading" class="ef-read"><UiText k={I18nKey.search} /></h1>
        </header>
        <ArticleSearch client:only="svelte" />
    </section>
</MainGridLayout>

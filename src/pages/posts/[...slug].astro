---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getCategoryUrl, getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { efDate, makePostNumbers } from "../../utils/post-index";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const allPosts = await getSortedPosts();
const numbers = makePostNumbers(allPosts);
const number = numbers.get(entry.slug) ?? "";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: efDate(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const prevNumber = entry.data.prevSlug ? numbers.get(entry.data.prevSlug) ?? "" : "";
const nextNumber = entry.data.nextSlug ? numbers.get(entry.data.nextSlug) ?? "" : "";
---

<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} showProfile={false} showWidgets={false}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <article class="ef-sheet post-sheet" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">
        <p class="ef-crumb ef-field">
            <a href={url("/")}>{i18n(I18nKey.home)}</a><span>{entry.data.category || i18n(I18nKey.uncategorized)}</span>
        </p>

        <p class="ids">
            <a class="ef-tag is-current" href={Astro.url.pathname} aria-current="page">{number}</a>
            <a class="ef-kv" href={getCategoryUrl(entry.data.category)}>
                <span>{i18n(I18nKey.categories)}</span>
                <span>{entry.data.category || i18n(I18nKey.uncategorized)}</span>
            </a>
        </p>

        <PostMetadata
            class="post-meta"
            published={entry.data.published}
            updated={entry.data.updated}
            tags={entry.data.tags}
            category={entry.data.category}
        ></PostMetadata>

        <h1 class="ef-read post-title">{entry.data.title}</h1>
        <div class="ef-tri" aria-hidden="true"><i></i><i></i><i></i></div>

        {entry.data.description && (
            <p class="ef-lede ef-read post-lede">{entry.data.description}</p>
        )}

        {entry.data.image && (
            <ImageWrapper
                id="post-cover"
                src={entry.data.image}
                basePath={path.join("content/posts/", getDir(entry.id))}
                class="post-cover"
                alt={entry.data.title}
            />
        )}

        <Markdown class="post-prose ef-prose ef-in-power">
            <Content />
        </Markdown>

        {licenseConfig.enable && (
            <License
                title={entry.data.title}
                slug={entry.slug}
                pubDate={entry.data.published}
                class="post-license"
            ></License>
        )}
    </article>

    <nav class="post-nav" aria-label={i18n(I18nKey.previousPost)}>
        <ol class="ef-records">
            {entry.data.nextSlug && (
                <li>
                    <a class="ef-record" href={getPostUrlBySlug(entry.data.nextSlug)}>
                        <span class="ef-tag">{nextNumber}</span>
                        <span class="ef-field">{i18n(I18nKey.previousPost)}</span>
                        <span class="name ef-read">{entry.data.nextTitle}</span>
                        <span class="ef-field" aria-hidden="true">←</span>
                    </a>
                </li>
            )}
            {entry.data.prevSlug && (
                <li>
                    <a class="ef-record" href={getPostUrlBySlug(entry.data.prevSlug)}>
                        <span class="ef-tag">{prevNumber}</span>
                        <span class="ef-field">{i18n(I18nKey.nextPost)}</span>
                        <span class="name ef-read">{entry.data.prevTitle}</span>
                        <span class="ef-field" aria-hidden="true">→</span>
                    </a>
                </li>
            )}
        </ol>
    </nav>
</MainGridLayout>

<style>
    /* One measure plus the sheet's own side padding, centred in the column. The
       line length is decided by --ef-measure (33rem = 660px). The wide 32px
       padding is desktop-only: on a phone it would narrow the reading column to
       ~13 characters, so below 1200 the sheet keeps 1rem and the 660 measure.
       Cap = 660 + 2 x 32 = 724, so at 1200+ the column (712) sets the box. */
    .post-sheet {
        max-width: calc(var(--ef-measure) + 3.2rem);
        margin-inline: auto;
        padding-inline: 1rem;
    }
    @media (min-width: 1200px) {
        .post-sheet {
            padding-inline: 1.6rem;
        }
    }
    .ids {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 0.75rem;
    }
    .post-meta {
        margin: 0 0 1.25rem;
    }
    .post-title {
        margin: 0 0 0.75rem;
        font-family: var(--ef-font-ui);
        font-size: clamp(1.9rem, 4vw, var(--ef-t-h1));
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.01em;
    }
    .post-lede {
        margin: 1.25rem 0 0;
        font-size: 1.05rem;
        color: var(--ef-ink-2);
    }
    .post-cover {
        margin: 1.75rem 0;
        border: 1px solid var(--ef-rule);
        aspect-ratio: 16 / 9;
    }
    .post-prose {
        margin-top: 2rem;
    }
    .post-license {
        margin-top: 2.5rem;
    }

    .post-nav {
        margin-inline: auto;
        max-width: calc(var(--ef-measure) + 2rem);
        margin-top: 2.5rem;
    }
</style>

---
import path from "node:path";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getCategoryUrl, getDir, getPostUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "../../components/misc/ImageWrapper.astro";
import PostMetadata from "../../components/PostMeta.astro";
import { profileConfig, siteConfig } from "../../config";
import { efDate, makePostNumbers } from "../../utils/post-index";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

const allPosts = await getSortedPosts();
const numbers = makePostNumbers(allPosts);
const number = numbers.get(entry.slug) ?? "";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: efDate(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const prevNumber = entry.data.prevSlug
	? (numbers.get(entry.data.prevSlug) ?? "")
	: "";
const nextNumber = entry.data.nextSlug
	? (numbers.get(entry.data.nextSlug) ?? "")
	: "";
---

<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings} showProfile={false} showWidgets={false}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <article class="ef-sheet post-sheet" data-pagefind-body data-pagefind-weight="10">
        <header class="post-header">
            <p class="ids">
                <a class="ef-tag is-current" href={Astro.url.pathname} aria-current="page">{number}</a>
                <a class="ef-kv" href={getCategoryUrl(entry.data.category)}>
                    <span>{i18n(I18nKey.categories)}</span>
                    <span>{entry.data.category || i18n(I18nKey.uncategorized)}</span>
                </a>
            </p>

            <h1 class="ef-read post-title" data-pagefind-meta="title">{entry.data.title}</h1>

            <PostMetadata
                class="post-meta"
                published={entry.data.published}
                updated={entry.data.updated}
                tags={entry.data.tags}
            ></PostMetadata>

            {entry.data.description && (
                <p class="ef-lede ef-read post-lede">{entry.data.description}</p>
            )}

            <div class="ef-tri" aria-hidden="true"><i></i><i></i><i></i></div>
        </header>

        {entry.data.image && (
            <ImageWrapper
                id="post-cover"
                src={entry.data.image}
                basePath={path.join("content/posts/", getDir(entry.id))}
                class="post-cover"
                alt={entry.data.title}
            />
        )}

        <Markdown class="post-prose ef-prose ef-in-power">
            <Content />
        </Markdown>

        {licenseConfig.enable && (
            <License
                title={entry.data.title}
                slug={entry.slug}
                pubDate={entry.data.published}
                class="post-license"
            ></License>
        )}
    </article>

    <nav class="post-nav" aria-label={i18n(I18nKey.previousPost)}>
        <ol class="ef-records">
            {entry.data.nextSlug && (
                <li>
                    <a class="ef-record" href={getPostUrlBySlug(entry.data.nextSlug)}>
                        <span class="ef-tag">{nextNumber}</span>
                        <span class="ef-field">{i18n(I18nKey.previousPost)}</span>
                        <span class="name ef-read">{entry.data.nextTitle}</span>
                        <span class="ef-field" aria-hidden="true">←</span>
                    </a>
                </li>
            )}
            {entry.data.prevSlug && (
                <li>
                    <a class="ef-record" href={getPostUrlBySlug(entry.data.prevSlug)}>
                        <span class="ef-tag">{prevNumber}</span>
                        <span class="ef-field">{i18n(I18nKey.nextPost)}</span>
                        <span class="name ef-read">{entry.data.prevTitle}</span>
                        <span class="ef-field" aria-hidden="true">→</span>
                    </a>
                </li>
            )}
        </ol>
    </nav>
</MainGridLayout>

<style>
    /* The shell widens the article to the right of the home column's left edge.
       Keep the type scale local, so index and navigation stay stable. */
    .post-sheet {
        --ef-t-body: 0.9rem;
        --ef-t-h2: 1.3rem;
        --ef-measure: 100%;
        width: 100%;
        max-width: none;
        margin-inline: auto;
        padding-inline: 1rem;
    }
    @media (min-width: 1200px) {
        .post-sheet {
            padding-inline: 1.6rem;
        }
    }
    .post-header {
        display: grid;
        gap: 1.2rem;
    }
    .post-header .ef-tri {
        margin-top: 0.4rem;
    }
    .ids {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }
    .post-meta {
        margin: 0;
    }
    .post-title {
        margin: 0;
        font-family: var(--ef-font-ui);
        font-size: clamp(1.4rem, 3vw, 1.8rem);
        font-weight: 700;
        line-height: 1.4;
        letter-spacing: -0.01em;
        overflow-wrap: anywhere;
    }
    .post-lede {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.9;
        color: var(--ef-ink-2);
    }
    .post-cover {
        margin: 1.75rem 0;
        border: 1px solid var(--ef-rule);
        aspect-ratio: 16 / 9;
    }
    .post-sheet :global(.post-prose) {
        margin-top: 2rem;
    }
    .post-sheet :global(.custom-md h1) {
        font-size: 1.5rem;
    }
    .post-sheet :global(.custom-md h3) {
        font-size: 1.1rem;
    }
    .post-sheet :global(.custom-md :is(h4, h5, h6)) {
        font-size: 1rem;
    }
    .post-sheet :global(.custom-md table) {
        font-size: 0.875rem;
    }
    .post-license {
        margin-top: 2.5rem;
    }

    .post-nav {
        margin-inline: auto;
        width: 100%;
        margin-top: 2.5rem;
    }
</style>

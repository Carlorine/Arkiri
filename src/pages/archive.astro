---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts, getSortedPostsList } from "../utils/content-utils";
import { makePostNumbers } from "../utils/post-index";

const sortedPostsList = await getSortedPostsList();
const numbers = Object.fromEntries(makePostNumbers(await getSortedPosts()));
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel sortedPosts={sortedPostsList} {numbers} client:only="svelte"></ArchivePanel>
</MainGridLayout>

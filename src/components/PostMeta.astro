---
import { efDate } from "../utils/post-index";
import { getTagUrl } from "../utils/url-utils";
import UiText from "./common/UiText.astro";

interface Props {
	class: string;
	published: Date;
	updated?: Date;

	tags: string[];
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;
const hasUpdate =
	!hideUpdateDate && updated && updated.getTime() !== published.getTime();
const visibleTags = tags.map((tag) => tag.trim()).filter(Boolean);
---
<div class:list={["ef-field meta-facts", className]}>
    <time datetime={published.toISOString()}>{efDate(published)}</time>
    {hasUpdate && (
        <span class="updated">
            <span class="divider" aria-hidden="true">｜</span>
            <span><UiText en="Updated" zh="更新于" /> <time datetime={(updated as Date).toISOString()}>{efDate(updated as Date)}</time></span>
        </span>
    )}
    {visibleTags.length > 0 && (
        <span class:list={["meta-tags", { "hide-tags-on-mobile": hideTagsForMobile }]}>
            <span class="divider" aria-hidden="true">｜</span>
            {visibleTags.map((tag, index) => (
                <span class="tag">
                    {index === 0
                        ? <span class="hash" aria-hidden="true">#</span>
                        : <span class="sep" aria-hidden="true">/</span>}
                    <a href={getTagUrl(tag)} rel="tag">{tag}</a>
                </span>
            ))}
        </span>
    )}
</div>

<style>
    .meta-facts {
        line-height: 1.9;
        letter-spacing: 0;
        overflow-wrap: anywhere;
    }
    .meta-facts time {
        white-space: nowrap;
    }
    .meta-facts .divider {
        margin-inline: 0.55rem;
        color: var(--ef-rule);
    }
    .meta-facts .hash {
        margin-right: 0.35rem;
    }
    .meta-facts a {
        color: inherit;
    }
    .meta-facts a:hover {
        color: var(--ef-ink);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }
    .meta-facts .sep {
        margin: 0 0.35rem;
        color: var(--ef-rule);
    }
    @media (max-width: 719px) {
        .hide-tags-on-mobile {
            display: none;
        }
    }
</style>

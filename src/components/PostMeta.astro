---
import { i18n } from "../i18n/translation";
import I18nKey from "../i18n/i18nKey";
import { efDate } from "../utils/post-index";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;
const hasUpdate =
	!hideUpdateDate && updated && updated.getTime() !== published.getTime();
---
<ul class:list={["ef-facts ef-field meta-facts", className]}>
    <li><time datetime={published.toISOString()}>{efDate(published)}</time></li>
    {hasUpdate && <li><time datetime={(updated as Date).toISOString()}>{efDate(updated as Date)}</time></li>}
    <li>
        <a href={getCategoryUrl(category)}>{category || i18n(I18nKey.uncategorized)}</a>
    </li>
    {tags && tags.length > 0 && (
        <li class:list={[{ "tags-on-mobile": !hideTagsForMobile }]}>
            {tags.map((tag, index) => (
                <span class="tag">
                    {index > 0 && <span class="sep" aria-hidden="true">/</span>}
                    <a href={getTagUrl(tag)}>{tag.trim()}</a>
                </span>
            ))}
        </li>
    )}
</ul>

<style>
    .meta-facts a {
        color: inherit;
    }
    .meta-facts a:hover {
        color: var(--ef-ink);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }
    .meta-facts .sep {
        margin: 0 0.35rem;
        color: var(--ef-rule);
    }
    @media (max-width: 719px) {
        .meta-facts li:not(.tags-on-mobile) {
            font-size: 0.75rem;
        }
        .meta-facts li:has(.tag) {
            display: none;
        }
        .meta-facts li.tags-on-mobile {
            display: block;
        }
    }
</style>

---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
    <ul class="ef-facts ef-field">
        <li>&copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}</li>
        <li><a href={url("rss.xml")} target="_blank" rel="noopener">RSS</a></li>
        <li><a href={url("sitemap-index.xml")} target="_blank" rel="noopener">Sitemap</a></li>
        <li><a href="https://astro.build" target="_blank" rel="noopener">Astro</a></li>
        <li><a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener">Fuwari</a></li>
    </ul>
</footer>

<style>
    /* One hairline, one row of real fields. No dashed lines, no box. */
    .site-footer {
        margin-top: 3.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--ef-rule);
    }
    .site-footer .ef-facts {
        margin: 0;
        padding: 0;
    }
    .site-footer a {
        color: var(--ef-ink-2);
    }
    .site-footer a:hover {
        color: var(--ef-ink);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
    }
</style>

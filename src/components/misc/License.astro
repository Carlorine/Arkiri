---
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { efDate } from "../../utils/post-index";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
}

const { title, pubDate } = Astro.props;
const className = Astro.props.class;
const licenseConf = licenseConfig;
const postUrl = decodeURIComponent(Astro.url.toString());
---
<section class:list={["license", className]} aria-label={i18n(I18nKey.license)}>
    <p class="ef-eyebrow slash license-head">{i18n(I18nKey.license)}</p>
    <p class="license-title">{title}</p>
    <a class="license-url ef-field" href={postUrl}>{postUrl}</a>
    <ul class="ef-facts ef-field license-facts">
        <li><span>{i18n(I18nKey.author)}</span> {profileConfig.name}</li>
        <li><span>{i18n(I18nKey.publishedAt)}</span> <time datetime={pubDate.toISOString()}>{efDate(pubDate)}</time></li>
        <li><a href={licenseConf.url} target="_blank" rel="noopener">{licenseConf.name}</a></li>
    </ul>
</section>

<style>
    .license {
        padding: 1rem 0 0;
        border-top: 1px solid var(--ef-rule);
    }
    .license-head {
        margin: 0 0 0.5rem;
    }
    .license-title {
        margin: 0 0 0.25rem;
        font-weight: 700;
    }
    .license-url {
        display: block;
        margin-bottom: 0.6rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .license-url:hover {
        color: var(--ef-ink);
        text-decoration: underline;
    }
    .license-facts {
        margin: 0;
    }
    .license-facts span {
        color: var(--ef-ink-2);
    }
    .license-facts a:hover {
        color: var(--ef-ink);
        text-decoration: underline;
    }
</style>

---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

// for test
let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<nav class:list={[className, "pagination"]} style={style} aria-label="Pagination">
    {page.url.prev ? (
        <a href={page.url.prev} aria-label="Previous Page" class="ef-btn small page step">
            <Icon name="material-symbols:chevron-left-rounded"></Icon>
        </a>
    ) : (
        <span class="ef-btn small page step is-off" aria-hidden="true">
            <Icon name="material-symbols:chevron-left-rounded"></Icon>
        </span>
    )}

    {pages.map((p) => {
        if (p === HIDDEN)
            return <span class="gap" aria-hidden="true">…</span>;
        if (p === page.currentPage)
            return <span class="ef-btn small page current" aria-current="page">{p}</span>;
        return (
            <a href={url(getPageUrl(p))} aria-label={`Page ${p}`} class="ef-btn small page">{p}</a>
        );
    })}

    {page.url.next ? (
        <a href={page.url.next} aria-label="Next Page" class="ef-btn small page step">
            <Icon name="material-symbols:chevron-right-rounded"></Icon>
        </a>
    ) : (
        <span class="ef-btn small page step is-off" aria-hidden="true">
            <Icon name="material-symbols:chevron-right-rounded"></Icon>
        </span>
    )}
</nav>

<style>
    .pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
    }
    /* 44px square targets with the kit's cut corner, so the pager is usable
       by touch as well as by mouse */
    .page {
        min-width: 2.75rem;
        min-height: 2.75rem;
        justify-content: center;
        padding: 0.5rem 0.95rem 0.5rem 0.7rem;
        font-variant-numeric: tabular-nums;
    }
    .step {
        padding-inline: 0.6rem;
    }
    .step :global(svg) {
        font-size: 1.35rem;
    }
    .current {
        --fill: var(--ef-signal);
        color: var(--ef-on-signal);
        font-weight: 800;
    }
    .is-off {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .gap {
        padding: 0 0.15rem;
        color: var(--ef-ink-2);
        font-family: var(--ef-font-ui);
    }
</style>

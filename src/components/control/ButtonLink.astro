---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
}
const { badge, url, label } = Astro.props;
---
<a href={url} aria-label={label} class="ledger-row">
    <span class="name"><slot></slot></span>
    {badge !== undefined && badge !== null && badge !== '' && (
        <span class="ef-field count">{badge}</span>
    )}
</a>

<style>
    /* A "label | number" row for the page margin: hairline between rows,
       the count in the wide tabular face. Never a rounded pill. */
    .ledger-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        min-height: 2.25rem;
        padding: 0.35rem 0.5rem;
        border-bottom: 1px solid var(--ef-rule);
        color: var(--ef-ink);
        transition: background-color 120ms var(--ef-ease);
    }
    .ledger-row:hover {
        background: var(--ef-chip);
    }
    .ledger-row .name {
        font-size: 0.9375rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .ledger-row .count {
        flex: none;
        color: var(--ef-ink-2);
        font-variant-numeric: tabular-nums;
    }
</style>

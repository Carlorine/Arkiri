---
import { profileConfig, siteConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { uiPair } from "../../utils/ui-i18n";
import { url } from "../../utils/url-utils";
import UiText from "../common/UiText.astro";

interface Recent {
	no: string;
	url: string;
	title: string;
	date: string;
}

interface Props {
	total: number;
	totalWords: number;
	latest: Recent & { words: number; minutes: number };
}

const { total, totalWords, latest } = Astro.props;

// plural forms: the number is real, so the unit has to agree with it
const wordPair = (n: number) =>
	uiPair(n === 1 ? I18nKey.wordCount : I18nKey.wordsCount);
const postPair = (n: number) =>
	uiPair(n === 1 ? I18nKey.postCount : I18nKey.postsCount);
---

<section class="hero">
    <div class="hero-copy">
        <p class="ef-eyebrow slash hero-site-name">{siteConfig.title}</p>
        <ul class="ef-facts ef-field hero-facts">
            <li>{total} <UiText en={postPair(total).en} zh={postPair(total).zh} /></li>
            <li>{totalWords.toLocaleString("en-US")} <UiText en={wordPair(totalWords).en} zh={wordPair(totalWords).zh} /></li>
            <li><UiText k={I18nKey.latestPost} /> {latest.date}</li>
        </ul>

        <h1 class="ef-wordmark">
            <span class="solid ef-in-drive">{siteConfig.title}</span>
        </h1>

        {profileConfig.bio && (
            <p class="hero-marker">
                <span class="ef-marker">{profileConfig.bio}</span>
            </p>
        )}

        <p class="ef-actions hero-actions">
            <a class="ef-btn go" href={latest.url}>
                <UiText k={I18nKey.latestPost} /> <span class="sub">{latest.no}</span>
            </a>
            <a class="ef-btn" href={url("/archive/")}><UiText k={I18nKey.archive} /></a>
            <a class="ef-btn" href={url("/about/")}><UiText k={I18nKey.about} /></a>
        </p>
    </div>

</section>

<style>
    /* Separate the introduction from the article list. */
    .hero {
        display: block;
        margin-bottom: 2rem;
    }
    .hero-site-name {
        text-transform: uppercase;
    }
    .hero-facts {
        margin-bottom: 1.25rem;
    }
    .hero .ef-wordmark {
        --ef-wordmark: clamp(3.2rem, 7vw, 7rem);
        font-weight: 700;
        margin: 0 0 1.25rem;
    }
    .hero-marker {
        max-width: var(--ef-measure);
        margin: 0 0 1rem;
        font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    }
    .hero-marker .ef-marker {
        background: none;
        color: var(--ef-ink);
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
    }

</style>

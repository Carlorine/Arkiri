---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { profileConfig, siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Recent {
	no: string;
	url: string;
	title: string;
	date: string;
}

interface Props {
	total: number;
	totalWords: number;
	latest: Recent & { words: number; minutes: number };
	recent: Recent[];
}

const { total, totalWords, latest, recent } = Astro.props;
const tickerItems = recent.slice(0, 6);
const no3 = latest.no.replace("No.", "");

// plural forms: the number is real, so the unit has to agree with it
const word = (n: number) => i18n(n === 1 ? I18nKey.wordCount : I18nKey.wordsCount);
const minute = (n: number) => i18n(n === 1 ? I18nKey.minuteCount : I18nKey.minutesCount);
const post = (n: number) => i18n(n === 1 ? I18nKey.postCount : I18nKey.postsCount);
---

<section class="hero">
    <div class="hero-copy">
        <p class="ef-eyebrow slash">{siteConfig.title}</p>
        <ul class="ef-facts ef-field hero-facts">
            <li>{total} {post(total)}</li>
            <li>{totalWords.toLocaleString("en-US")} {word(totalWords)}</li>
            <li>{i18n(I18nKey.latestPost)} {latest.date}</li>
        </ul>

        <h1 class="ef-wordmark">
            <span class="solid ef-in-drive">{siteConfig.title}</span>
            {siteConfig.subtitle && (
                <span class="hollow ef-in-drive" aria-hidden="true">{siteConfig.subtitle}</span>
            )}
        </h1>

        {profileConfig.bio && (
            <p class="hero-marker">
                <span class="ef-marker ef-in-stroke">{profileConfig.bio}</span>
            </p>
        )}

        <p class="ef-actions hero-actions">
            <a class="ef-btn go" href={latest.url}>
                {i18n(I18nKey.latestPost)} <span class="sub">{latest.no}</span>
            </a>
            <a class="ef-btn" href={url("/archive/")}>{i18n(I18nKey.archive)}</a>
            <a class="ef-btn" href={url("/about/")}>{i18n(I18nKey.about)}</a>
        </p>
    </div>

    <a class="latest" href={latest.url} aria-label={latest.title}>
        <span class="ef-hollow-no" aria-hidden="true">{no3}</span>
        <span class="latest-body">
            <span class="ef-field">{latest.date} / {latest.words} {word(latest.words)} / {latest.minutes} {minute(latest.minutes)}</span>
            <span class="latest-title ef-read">{latest.title}</span>
        </span>
    </a>

    {tickerItems.length > 0 && (
        <div class="ef-ticker" aria-label={i18n(I18nKey.recentPosts)}>
            <div class="track">
                <ul>
                    {tickerItems.map((item) => (
                        <li><a href={item.url}><b>{item.no}</b>{item.title}</a></li>
                    ))}
                </ul>
                <ul aria-hidden="true">
                    {tickerItems.map((item) => (
                        <li><a href={item.url} tabindex="-1"><b>{item.no}</b>{item.title}</a></li>
                    ))}
                </ul>
            </div>
        </div>
    )}
</section>

<style>
    /* Showcase: the wordmark is the main visual. The column is one reading
       measure wide, so the latest-record block sits under the copy as a
       horizontal strip instead of competing for width. */
    .hero {
        display: block;
    }
    .hero-facts {
        margin-bottom: 1.25rem;
    }
    .hero .ef-wordmark {
        --ef-wordmark: clamp(2.5rem, 5vw, 6rem);
        margin: 0 0 1.25rem;
    }
    .hero-marker {
        max-width: var(--ef-measure);
        margin: 0 0 1rem;
        font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    }
    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
    }

    .latest {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2rem;
        padding: 0.9rem 0.25rem;
        border-top: 1px solid var(--ef-rule);
        border-bottom: 1px solid var(--ef-rule);
        color: var(--ef-ink);
    }
    .latest .ef-hollow-no {
        flex: none;
        font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    }
    .latest-body {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }
    .latest-title {
        font-size: 1.1rem;
        font-weight: 700;
        line-height: 1.4;
    }
    .latest:hover .latest-title {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 0.2em;
    }

    .hero .ef-ticker {
        margin: 2.25rem 0 0;
    }
    /* hold the strip for 1.5s so the opening frame shows No.006 whole; the
       marquee itself starts from translateX(0) */
    .hero .ef-ticker .track {
        animation-delay: 1.5s;
    }

    @media (max-width: 719px) {
        .latest {
            gap: 0.75rem;
        }
        .latest .ef-hollow-no {
            font-size: 2.25rem;
        }
    }
</style>

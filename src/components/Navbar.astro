---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import { isNavPathCurrent } from "../utils/nav-utils";
import LangSwitch from "./common/LangSwitch.astro";
import LightDarkSwitch from "./LightDarkSwitch.astro";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);

const enLabels: Record<string, string> = {
    "/": "Home", "/archive/": "Archive", "/about/": "About",
};
const enLabel = (link: NavBarLink): string => enLabels[link.url] ?? link.name;
const isCurrent = (link: NavBarLink): boolean =>
	!link.external && isNavPathCurrent(Astro.url.pathname, url(link.url));
---

<div class="nav-space" aria-hidden="true"></div>
<button class="nav-reveal" aria-label="Show navigation" aria-controls="site-navigation" hidden>
    <span aria-hidden="true"></span>
</button>
<header id="site-navigation" lang="en" class:list={["nav-shell", className]}>
    <div class="nav-surface" aria-hidden="true"></div>
    <div class="nav-inner">
    <nav class="ef-rail" aria-label={siteConfig.title}>
        <a class="brand" href={url("/")} aria-label={siteConfig.title}>
            <span class="brand-name">{siteConfig.title}</span>
        </a>
        <div class="links">
            {links.map((link) => (
                <a href={link.external ? link.url : url(link.url)}
                   aria-current={isCurrent(link) ? "page" : undefined}
                   target={link.external ? "_blank" : null}
                   rel={link.external ? "noopener" : null}
                >
                    {enLabel(link)}
                </a>
            ))}
        </div>
    </nav>

    <div class="nav-tools">
        <a href={url("/search/")} class="icon-btn search-link" id="search-switch" aria-label="Search">
            <Icon name="material-symbols:search" class="text-[1.25rem]" />
        </a>
        <div class="tool-row">
            <button aria-label="Motion" class="icon-btn" id="display-settings-switch" aria-controls="display-setting" aria-expanded="false">
                <Icon name="material-symbols:tune-rounded" class="text-[1.25rem]"></Icon>
            </button>
            <LightDarkSwitch englishOnly />
            <LangSwitch englishOnly />
        </div>
        <button aria-label="Menu" name="Nav Menu" class="icon-btn menu-btn" id="nav-menu-switch" aria-controls="nav-menu-panel" aria-expanded="false">
            <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
        </button>
    </div>

    </div>
    <NavMenuPanel links={links}></NavMenuPanel>
    <DisplaySettings englishOnly client:only="svelte" />
</header>

<style>
    .nav-space { height: var(--site-header-height); }
    .nav-shell {
        position: fixed;
        top: env(safe-area-inset-top, 0px);
        inset-inline: 0;
        z-index: 60;
        color: var(--ef-ink);
        translate: 0 0;
        transition:
            translate 240ms var(--ef-mech),
            transform 220ms var(--ef-snap),
            opacity 140ms var(--ef-mech);
    }
    /* The surface contracts while labels move inward without scaling type. */
    .nav-surface {
        position: absolute;
        inset: 0;
        pointer-events: none;
        border: 1px solid transparent;
        border-bottom-color: var(--ef-rule);
        border-radius: 0;
        background: var(--ef-paper);
        transform-origin: center;
        transition:
            transform 240ms var(--ef-mech),
            border-radius 240ms var(--ef-mech),
            border-color 160ms var(--ef-ease),
            background-color 160ms var(--ef-ease);
    }
    .nav-shell.is-floating { translate: 0 12px; }
    .is-floating .nav-surface {
        transform: scaleX(var(--nav-surface-scale, 0.96));
        border-color: var(--ef-rule);
        border-radius: 18px;
        background: var(--ef-panel);
    }
    .nav-shell.nav-hidden {
        transform: translateY(calc(-100% - 2rem));
        opacity: 0;
        pointer-events: none;
    }
    .nav-inner {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        height: 64px;
        padding-inline: clamp(24px, 4vw, 64px);
    }
    .nav-shell .ef-rail {
        display: flex;
        flex: 1;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-width: 0;
        padding: 0;
        border: 0;
    }
    .nav-shell .brand {
        flex: none;
        padding: 0;
        color: var(--ef-ink);
        letter-spacing: 0.04em;
    }
    .brand-name {
        font-family: var(--ef-font-ui);
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
        text-transform: uppercase;
    }
    .links { display: flex; gap: 0.5rem; }
    .brand, .links, .nav-tools {
        transition: translate 240ms var(--ef-mech);
    }
    .is-floating .brand { translate: 24px 0; }
    .is-floating .links, .is-floating .nav-tools { translate: -24px 0; }
    .nav-shell .links a {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0 12px;
        border-radius: 6px;
        background: transparent;
        transition: color 120ms var(--ef-ease), background-color 120ms var(--ef-ease);
        color: var(--ef-ink-2);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1;
    }
    .nav-shell .links a:is(:hover, :focus-visible) {
        background: var(--ef-chip);
        color: var(--ef-ink);
    }
    .nav-shell .links a[aria-current="page"] {
        border-radius: 6px;
        color: var(--ef-on-signal);
        background: var(--ef-signal);
    }
    .nav-tools, .tool-row { display: flex; flex: none; align-items: center; gap: 2px; }
    .nav-tools :global(astro-island) { display: contents; }
    .icon-btn, .nav-tools :global(.theme-toggle), .nav-tools :global(.lang-toggle) {
        display: flex;
        flex: 0 0 44px;
        align-items: center;
        justify-content: center;
        width: 44px;
        min-height: 44px;
        padding: 0;
        color: var(--ef-ink);
        background: transparent;
        border-radius: 6px;
        transition: color 120ms var(--ef-ease), background-color 120ms var(--ef-ease);
    }
    .icon-btn :global(svg), .nav-tools :global(.theme-toggle svg) { width: 24px; height: 24px; }
    .icon-btn:hover, .nav-tools :global(.theme-toggle:hover), .nav-tools :global(.lang-toggle:hover) {
        background: var(--ef-chip);
    }
    .icon-btn[aria-expanded="true"] {
        background: var(--ef-signal);
        color: var(--ef-on-signal);
    }
    .nav-shell.nav-hidden { transition-timing-function: var(--ef-mech); }
    .icon-btn:focus-visible, .brand:focus-visible, .links a:focus-visible, .nav-reveal:focus-visible {
        outline: 2px solid var(--ef-ink);
        outline-offset: 2px;
    }
    .nav-shell :global(#display-setting) {
        top: calc(100% + 8px);
        bottom: auto;
        right: clamp(24px, 4vw, 64px);
        max-width: calc(100vw - 24px);
    }
    .nav-shell :global(#nav-menu-panel) {
        position: absolute;
        top: calc(100% + 8px);
        left: 50%;
        right: auto;
        translate: -50% 0;
        width: min(20rem, calc(100vw - 24px));
    }
    .menu-btn { display: none; }
    .nav-reveal {
        position: fixed;
        top: 0;
        left: 50%;
        z-index: 61;
        display: flex;
        align-items: start;
        justify-content: center;
        width: min(34rem, 100%);
        height: 24px;
        padding-top: max(6px, env(safe-area-inset-top));
        transform: translateX(-50%);
        background: transparent;
        cursor: pointer;
    }
    .nav-reveal[hidden] { display: none; }
    .nav-reveal span {
        display: block;
        width: 36px;
        height: 4px;
        border-radius: 0;
        background: var(--ef-ink-2);
    }
    @media (max-width: 1099px) {
        .nav-inner { gap: 0.5rem; height: 56px; padding-inline: 24px; }
        .nav-shell .links, .tool-row :global(.lang-toggle) { display: none; }
        .brand-name { font-size: 1.2rem; }
        .menu-btn { display: flex; }
        .is-floating .nav-surface { border-radius: 16px; }
        .is-floating .brand, .is-floating .nav-tools { translate: none; }
        .nav-shell :global(#display-setting) {
            left: 50%;
            right: auto;
            translate: -50% 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .nav-shell, .nav-surface, .brand, .links, .nav-tools,
        .icon-btn, .nav-tools :global(.theme-toggle), .nav-tools :global(.lang-toggle) {
            transition: none;
        }
        .nav-shell.nav-hidden { transform: none; visibility: hidden; }
    }
    :global(:root[data-ef-motion="calm"]) .nav-shell,
    :global(:root[data-ef-motion="calm"]) .nav-surface,
    :global(:root[data-ef-motion="calm"]) .brand,
    :global(:root[data-ef-motion="calm"]) .links,
    :global(:root[data-ef-motion="calm"]) .nav-tools { transition: none; }
</style>

<script>
import { isNavPathCurrent } from "../utils/nav-utils";

/**
 * The top navigation and the drawer sit outside the swup container, so their
 * aria-current is never repainted by a page swap. Recompute it from the URL on
 * first load and after every visit: exactly one item (or none, on a post) is
 * marked, with the same trailing-slash rules the server render uses.
 */
function syncCurrent() {
    const here = location.pathname;
    const items = document.querySelectorAll(
        ".nav-shell .links a[href], #nav-menu-panel .drawer-item[href]",
    );
    items.forEach((item) => {
        const href = item.getAttribute("href") || "";
        let matches = false;
        try {
            const target = new URL(href, location.origin);
            matches = target.origin === location.origin && isNavPathCurrent(here, target.pathname);
        } catch {
            // An invalid or external URL is never the current local section.
        }
        if (matches) item.setAttribute("aria-current", "page");
        else item.removeAttribute("aria-current");
    });
}
syncCurrent();
document.addEventListener("swup:page:view", syncCurrent);
document.addEventListener("swup:visit:end", syncCurrent);

const header = document.querySelector<HTMLElement>(".nav-shell");
const reveal = document.querySelector<HTMLButtonElement>(".nav-reveal");
if (header && reveal) {
    const panels = [
        { panel: "display-setting", button: "display-settings-switch" },
        { panel: "nav-menu-panel", button: "nav-menu-switch" },
    ];
    let lastY = Math.max(0, window.scrollY);
    let travel = 0;
    let frame = 0;
    let hovered = false;
    let navigating = false;
    let floating = false;
    let floatingSince = 0;
    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    function syncSurfaceWidth() {
        const gutter = window.innerWidth < 1100 ? 12 : Math.min(64, Math.max(24, window.innerWidth * 0.04));
        header!.style.setProperty("--nav-surface-scale", String((window.innerWidth - gutter * 2) / window.innerWidth));
    }
    function setFloating(next: boolean) {
        if (floating === next) return;
        floating = next;
        floatingSince = performance.now();
        header!.classList.toggle("is-floating", next);
        show();
    }
    syncSurfaceWidth();
    window.addEventListener("resize", syncSurfaceWidth, { passive: true });

    function panelOpen() {
        return panels.some(({ panel }) => {
            const element = document.getElementById(panel);
            return element && !element.classList.contains("float-panel-closed");
        });
    }
    function show() {
        clearTimeout(hideTimer);
        if (header!.classList.contains("nav-hidden")) header!.classList.remove("nav-hidden");
        header!.inert = false;
        const wasFocused = document.activeElement === reveal;
        reveal!.hidden = true;
        if (wasFocused) header!.querySelector<HTMLAnchorElement>(".brand")?.focus({ preventScroll: true });
    }
    function hide() {
        if (!floating || hovered || navigating || panelOpen() || header!.querySelector(":focus-visible")) return;
        header!.classList.add("nav-hidden");
        header!.inert = true;
        reveal!.hidden = false;
    }
    function update() {
        frame = 0;
        const y = Math.max(0, window.scrollY);
        const delta = y - lastY;
        if (Math.sign(delta) !== Math.sign(travel)) travel = 0;
        travel += delta;
        lastY = y;
        // A small hysteresis prevents docking chatter around the threshold.
        if (y <= 8) setFloating(false);
        else if (y > 64) setFloating(true);
        if (!floating || travel < -8) show();
        else if (y > 160 && travel > 16) {
            // Let the docking motion finish before the first scroll-away exit.
            clearTimeout(hideTimer);
            const delay = Math.max(0, 240 - (performance.now() - floatingSince));
            hideTimer = setTimeout(hide, delay);
        }
    }
    window.addEventListener("scroll", () => {
        if (!frame) frame = requestAnimationFrame(update);
    }, { passive: true });
    header.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") hovered = true;
        show();
    });
    header.addEventListener("pointerleave", () => { hovered = false; });
    header.addEventListener("focusin", show);
    reveal.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "mouse") show();
    });
    reveal.addEventListener("click", () => {
        show();
        header.querySelector<HTMLAnchorElement>(".brand")?.focus({ preventScroll: true });
    });
    for (const { panel, button } of panels) {
        document.getElementById(button)?.addEventListener("click", () => {
            document.getElementById(panel)?.classList.toggle("float-panel-closed");
            show();
        });
    }
    // The settings island hydrates later. Observe its insertion as well as
    // popover classes so expanded state follows outside-click dismissal too.
    const observer = new MutationObserver((records) => {
        if (!records.some((record) => record.type === "childList"
            || panels.some(({ panel }) => (record.target as HTMLElement).id === panel))) return;
        for (const { panel, button } of panels) {
            const open = !!document.getElementById(panel)
                && !document.getElementById(panel)!.classList.contains("float-panel-closed");
            document.getElementById(button)?.setAttribute("aria-expanded", String(open));
        }
        if (panelOpen()) show();
    });
    observer.observe(header, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });
    function closePanels() {
        for (const { panel } of panels) document.getElementById(panel)?.classList.add("float-panel-closed");
    }
    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const activePanel = panels.find(({ panel }) => {
            const element = document.getElementById(panel);
            return element && !element.classList.contains("float-panel-closed");
        });
        if (activePanel) {
            closePanels();
            document.getElementById(activePanel.button)?.focus({ preventScroll: true });
        }
    });
    document.addEventListener("swup:visit:start", () => {
        navigating = true;
        closePanels();
        show();
    });
    document.addEventListener("swup:visit:end", () => {
        navigating = false;
        lastY = Math.max(0, window.scrollY);
        travel = 0;
        setFloating(lastY > 64);
        show();
    });
    setFloating(lastY > 64);
}
</script>

---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import UiText from "../common/UiText.astro";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;
const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith("/posts/");

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}
const maxDepth = Math.min(minDepth + (siteConfig.toc.depth ?? 2) - 1, 6);
const items = headings.filter((heading) => heading.depth <= maxDepth);

const removeTailingHash = (text: string) => {
	const lastIndexOfHash = text.lastIndexOf("#");
	return lastIndexOfHash === text.length - 1
		? text.substring(0, lastIndexOfHash)
		: text;
};

// 01, 02, ... — the number of each top-level section, a real position in the
// document, not decoration.
let sectionNo = 0;
const numbers = new Map<string, string>();
for (const heading of items) {
	if (heading.depth === minDepth) {
		sectionNo += 1;
		numbers.set(heading.slug, String(sectionNo).padStart(2, "0"));
	}
}
---
{isPostsRoute && items.length > 0 && (
    <table-of-contents class:list={[className, "ef-panel", "tab-right"]}>
        <p class="ef-eyebrow slash toc-head"><UiText en="On this page" zh="本页目录" /></p>
        <ol class="toc-list">
            {items.map((heading) => (
                <li class:list={{ sub: heading.depth > minDepth }}>
                    <a href={`#${heading.slug}`} class="toc-link">
                        {numbers.has(heading.slug) && <span class="n ef-field">{numbers.get(heading.slug)}</span>}
                        <span class="t">{removeTailingHash(heading.text)}</span>
                    </a>
                </li>
            ))}
        </ol>
    </table-of-contents>
)}

<style>
    table-of-contents {
        display: block;
    }
    .toc-head {
        margin: 0 0 0.75rem;
    }
    .toc-list {
        margin: 0;
        padding: 0;
        /* Keep the final chapter above the scroll area's bottom fade. */
        padding-bottom: 0.75rem;
        list-style: none;
    }
    .toc-link {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        min-height: 1.6rem;
        padding: 0.35rem 0.5rem;
        color: var(--ef-ink-2);
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.4;
        transition: color 120ms var(--ef-ease);
    }
    .toc-link:not([aria-current="true"]):hover {
        color: var(--ef-ink);
    }
    /* Keep keyboard focus visible against the neutral fill in both themes. */
    .toc-link:focus-visible {
        outline: 2px solid var(--ef-ink);
        outline-offset: -2px;
    }
    .toc-link .n {
        flex: none;
        color: var(--ef-ink-2);
        font-variant-numeric: tabular-nums;
    }
    .toc-link .t {
        min-width: 0;
    }
    .toc-list li.sub .toc-link {
        margin-left: 1rem;
        font-size: 0.8125rem;
    }
    /* Keep text metrics stable; indicate the current section with color only. */
    .toc-link[aria-current="true"] {
        color: var(--ef-ink);
        background: var(--ef-chip);
    }
    .toc-link[aria-current="true"] .n {
        color: var(--ef-ink);
    }
    @media (hover: none) {
        .toc-link {
            min-height: 2rem;
        }
    }
</style>

<script>
class TableOfContents extends HTMLElement {
    private links: HTMLAnchorElement[] = [];
    private headings: (HTMLElement | null)[] = [];
    private resizeObserver: ResizeObserver | null = null;
    private frame = 0;

    private revealCurrent(link: HTMLAnchorElement | undefined) {
        const scroller = this.closest<HTMLElement>(".margin-inner");
        if (!link || !scroller || scroller.clientHeight === 0) return;

        const bounds = scroller.getBoundingClientRect();
        if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) return;

        const inset = Math.min(
            2 * Number.parseFloat(getComputedStyle(document.documentElement).fontSize),
            scroller.clientHeight / 4,
        );
        const item = link.getBoundingClientRect();

        // Move only the TOC's own viewport. scrollIntoView would also move
        // the article, and the masked edges must not hide the active label.
        if (item.top < bounds.top + inset) {
            scroller.scrollTop += item.top - bounds.top - inset;
        } else if (item.bottom > bounds.bottom - inset) {
            scroller.scrollTop += item.bottom - bounds.bottom + inset;
        }
    }

    private update = () => {
        this.frame = 0;
        if (!this.isConnected) return;

        // Sections can contain other sections, so their intersection does not
        // identify the heading being read. Track the last heading above the
        // reading line instead; keep the first one selected before the prose.
        const readingLine = (document.querySelector(".nav-shell")?.getBoundingClientRect().bottom ?? 0)
            + 2 * Number.parseFloat(getComputedStyle(document.documentElement).fontSize);
        let current = this.headings.findIndex((heading) => heading !== null);
        this.headings.forEach((heading, index) => {
            if (heading && heading.getBoundingClientRect().top <= readingLine) current = index;
        });

        // Short final sections cannot always reach the reading line.
        if (window.scrollY > 0 && window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
            const last = this.headings.findLastIndex((heading) => heading !== null);
            if (last >= 0) current = last;
        }

        this.links.forEach((link, index) => {
            if (index === current) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
        });
        this.revealCurrent(this.links[current]);
    };

    private scheduleUpdate = () => {
        if (!this.frame) this.frame = requestAnimationFrame(this.update);
    };

    connectedCallback() {
        this.links = Array.from(this.querySelectorAll<HTMLAnchorElement>("a[href^='#']"));
        this.headings = this.links.map((link) => document.getElementById(decodeURIComponent(link.hash.substring(1))));
        window.addEventListener("scroll", this.scheduleUpdate, { passive: true });
        window.addEventListener("resize", this.scheduleUpdate);
        // Images and fonts can move headings without a scroll event.
        this.resizeObserver = new ResizeObserver(this.scheduleUpdate);
        const content = document.getElementById("swup-container");
        if (content) this.resizeObserver.observe(content);
        this.scheduleUpdate();
    }

    disconnectedCallback() {
        cancelAnimationFrame(this.frame);
        this.frame = 0;
        this.resizeObserver?.disconnect();
        this.resizeObserver = null;
        window.removeEventListener("scroll", this.scheduleUpdate);
        window.removeEventListener("resize", this.scheduleUpdate);
        this.links = [];
        this.headings = [];
    }
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>

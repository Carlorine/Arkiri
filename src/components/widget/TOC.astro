---
import type { MarkdownHeading } from "astro";
import UiText from "../common/UiText.astro";
import { siteConfig } from "../../config";

interface Props {
	class?: string;
	headings: MarkdownHeading[];
}

let { headings = [] } = Astro.props;
const className = Astro.props.class;
const isPostsRoute = Astro.url.pathname.startsWith("/posts/");

let minDepth = 10;
for (const heading of headings) {
	minDepth = Math.min(minDepth, heading.depth);
}
const maxDepth = Math.min(minDepth + (siteConfig.toc.depth ?? 2) - 1, 6);
const items = headings.filter((heading) => heading.depth <= maxDepth);

const removeTailingHash = (text: string) => {
	const lastIndexOfHash = text.lastIndexOf("#");
	return lastIndexOfHash === text.length - 1 ? text.substring(0, lastIndexOfHash) : text;
};

// 01, 02, ... — the number of each top-level section, a real position in the
// document, not decoration.
let sectionNo = 0;
const numbers = new Map<string, string>();
for (const heading of items) {
	if (heading.depth === minDepth) {
		sectionNo += 1;
		numbers.set(heading.slug, String(sectionNo).padStart(2, "0"));
	}
}
---
{isPostsRoute && items.length > 0 && (
    <table-of-contents class:list={[className, "ef-panel", "tab-right"]}>
        <p class="ef-eyebrow slash toc-head"><UiText en="On this page" zh="本页目录" /></p>
        <ol class="toc-list">
            {items.map((heading) => (
                <li class:list={{ sub: heading.depth > minDepth }}>
                    <a href={`#${heading.slug}`} class="toc-link">
                        {numbers.has(heading.slug) && <span class="n ef-field">{numbers.get(heading.slug)}</span>}
                        <span class="t">{removeTailingHash(heading.text)}</span>
                    </a>
                </li>
            ))}
        </ol>
    </table-of-contents>
)}

<style>
    table-of-contents {
        display: block;
    }
    .toc-head {
        margin: 0 0 0.75rem;
    }
    /* The contents is a panel like the two widget panels under it; the section
       being read is the rail's yellow block, cut at the same corner. */
    .toc-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .toc-link {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        padding: 0.35rem 0.5rem;
        color: var(--ef-ink-2);
        font-size: 0.875rem;
        line-height: 1.4;
        transition: color 120ms var(--ef-ease);
    }
    .toc-link:not([aria-current="true"]):hover {
        color: var(--ef-ink);
    }
    /* The current row is a yellow block, so the ring sits inside it and is drawn
       in ink: a trace ring would be yellow on yellow in the dark theme. */
    .toc-link:focus-visible {
        outline: 2px solid var(--ef-ink);
        outline-offset: -2px;
    }
    /* On the yellow block the ring must contrast with the fill, not with the
       text token: --ef-ink is light grey in the dark theme (1.06:1 on yellow),
       while the ink used on signal is #161616 in both themes (16.3:1). */
    .toc-link[aria-current="true"]:focus-visible {
        outline-color: var(--ef-on-signal);
    }
    .toc-link .n {
        flex: none;
        color: var(--ef-ink-2);
        font-variant-numeric: tabular-nums;
    }
    .toc-link .t {
        min-width: 0;
    }
    .toc-list li.sub .toc-link {
        margin-left: 1rem;
        font-size: 0.8125rem;
    }
    /* the section being read, in the rail's language: a solid yellow block,
       ink text, the 01 number in the same ink. No cut corner: the cut belongs
       to pressable things, and "you are here" is not one. */
    .toc-link[aria-current="true"] {
        color: var(--ef-on-signal);
        background: var(--ef-signal);
        font-weight: 700;
    }
    .toc-link[aria-current="true"] .n {
        color: var(--ef-on-signal);
    }
</style>

<script>
class TableOfContents extends HTMLElement {
    private links: HTMLAnchorElement[] = [];
    private ids: string[] = [];
    private sections: HTMLElement[] = [];
    private active: boolean[] = [];
    private observer: IntersectionObserver;
    private inited = false;
    private anchorTarget: HTMLElement | null = null;

    constructor() {
        super();
        this.observer = new IntersectionObserver(this.onIntersect, { threshold: 0 });
    }

    private onIntersect = (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry) => {
            const id = entry.target.firstElementChild?.getAttribute("id");
            const index = id ? this.ids.indexOf(id) : -1;
            if (index >= 0) this.active[index] = entry.isIntersecting;
            if (entry.isIntersecting && this.anchorTarget === entry.target.firstChild) {
                this.anchorTarget = null;
            }
        });

        if (!this.active.some(Boolean)) this.fallback();
        this.paint();
    };

    /** Ranges of visible sections stay lit, like a margin bracket. */
    private paint() {
        let first = -1;
        let last = -1;
        this.active.forEach((on, index) => {
            if (!on) return;
            if (first < 0) first = index;
            last = index;
        });

        this.links.forEach((link, index) => {
            const on = first >= 0 && index >= first && index <= last;
            // A link that has keyboard focus keeps its marker: repainting the
            // scroll spy while Tab rests on it must not make the yellow block
            // and its aria-current disappear under the focus ring.
            if (on || link === document.activeElement) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
        });
    }

    private fallback() {
        for (let index = 0; index < this.sections.length; index += 1) {
            const rect = this.sections[index].getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
                this.active[index] = true;
            } else if (rect.top > window.innerHeight) {
                break;
            }
        }
    }

    private onClick = (event: Event) => {
        const anchor = event
            .composedPath()
            .find((element): element is HTMLAnchorElement => element instanceof HTMLAnchorElement);
        const id = anchor ? decodeURIComponent(anchor.hash?.substring(1) ?? "") : "";
        this.anchorTarget = id ? document.getElementById(id) : null;
    };

    private onFocusIn = (event: Event) => {
        const target = event.target;
        if (!(target instanceof HTMLAnchorElement) || !target.classList.contains("toc-link")) return;
        // Keep the marker on the link the keyboard is on, even if a repaint is
        // already in flight; then repaint once with the focus in place.
        target.setAttribute("aria-current", "true");
        requestAnimationFrame(() => this.paint());
    };

    private init() {
        if (this.inited) return;
        this.inited = true;

        this.links = Array.from(this.querySelectorAll<HTMLAnchorElement>("a[href^='#']"));
        this.active = this.links.map(() => false);
        this.ids = this.links.map((link) => decodeURIComponent(link.hash?.substring(1) ?? ""));

        this.sections = this.ids.map((id) => {
            const heading = document.getElementById(id);
            const section = heading?.parentElement;
            return section instanceof HTMLElement ? section : document.body;
        });

        this.sections.forEach((section) => this.observer.observe(section));
        this.addEventListener("click", this.onClick, { capture: true });
        // Focus can land while the scroll spy is mid-repaint (the browser
        // scrolls the link into view, which changes intersections). Paint once
        // more after the focus settles so the focused link keeps its marker.
        this.addEventListener("focusin", this.onFocusIn, { capture: true });
        this.fallback();
        this.paint();
    }

    connectedCallback() {
        // No dependency on an entrance animation finishing: measure on the
        // next frame, and once more as a safety net after layout settles.
        requestAnimationFrame(() => this.init());
        window.setTimeout(() => this.init(), 600);
    }

    disconnectedCallback() {
        this.sections.forEach((section) => this.observer.unobserve(section));
        this.observer.disconnect();
        this.removeEventListener("click", this.onClick, { capture: true });
        this.removeEventListener("focusin", this.onFocusIn, { capture: true });
    }
}

if (!customElements.get("table-of-contents")) {
    customElements.define("table-of-contents", TableOfContents);
}
</script>

---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { isNavPathCurrent } from "../../utils/nav-utils";
import { url } from "../../utils/url-utils";
import LangSwitch from "../common/LangSwitch.astro";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
const enLabel = (link: NavBarLink) => {
	if (link.external) return link.name;
	const map: Record<string, string> = {
		"/": "Home",
		"/archive/": "Archive",
		"/about/": "About",
	};
	return map[link.url] ?? link.name;
};
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed nav-drawer"]}>
    <div class="drawer-grid">
        {links.map((link) => (
            <a href={link.external ? link.url : url(link.url)}
               class="drawer-item"
               aria-current={!link.external && isNavPathCurrent(Astro.url.pathname, url(link.url)) ? "page" : undefined}
               target={link.external ? "_blank" : null}
            >
                <span>{enLabel(link)}</span>
                {link.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="ext" />}
            </a>
        ))}
    </div>
    <div class="drawer-lang">
        <LangSwitch englishOnly />
    </div>
</div>

<style>
    /* A compact English menu anchored below the floating navigation. */
    .nav-drawer {
        position: fixed;
        top: calc(var(--site-header-height) + 0.5rem);
        left: 0.75rem;
        right: auto;
        width: min(24rem, calc(100vw - 1.5rem));
        max-width: calc(100vw - 1.5rem);
        padding: 0.75rem;
        border: 1px solid var(--ef-ink);
        background: var(--ef-panel);
    }
    .nav-drawer.float-panel-closed {
        visibility: hidden;
    }
    .drawer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2px;
        background: transparent;
    }
    .drawer-item {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.1rem;
        min-height: 44px;
        padding: 0.5rem 0.3rem;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: none;
        letter-spacing: 0.08em;
        background: transparent;
        border-radius: 6px;
        color: var(--ef-ink);
    }
    .drawer-item:is(:hover, :focus-visible) {
        background: var(--ef-chip);
    }
    .drawer-item[aria-current="page"] {
        border-radius: 6px;
        background: var(--ef-signal);
        color: var(--ef-on-signal);
    }
    .drawer-item .ext {
        position: absolute;
        right: 0.5rem;
        top: 0.5rem;
        width: 0.75rem;
        height: 0.75rem;
        opacity: 0.6;
    }
    .drawer-item {
        position: relative;
    }
    /* the language key sits at the bottom of the drawer on a phone */
    .drawer-lang {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--ef-rule);
    }
    .drawer-lang :global(.lang-toggle) {
        flex: 0 0 44px;
        width: 44px;
    }
</style>

---
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { getTranslation } from "@i18n/translation";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";
import LangSwitch from "../common/LangSwitch.astro";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
const enLabel = (link: NavBarLink) => {
	if (link.external) return link.name.toUpperCase();
	const map: Record<string, string> = {
		"/": "HOME",
		"/archive/": "ARCHIVE",
		"/about/": "ABOUT",
	};
	return map[link.url] ?? "";
};
// The big word follows the reader's language; the // eyebrow stays Latin.
const zhDict = getTranslation("zh_CN");
const zhMap: Record<string, string> = {
	"/": zhDict[I18nKey.home],
	"/archive/": zhDict[I18nKey.archive],
	"/about/": zhDict[I18nKey.about],
};
const zhLabel = (link: NavBarLink) => zhMap[link.url] ?? link.name;
---
<div id="nav-menu-panel" class:list={["float-panel float-panel-closed nav-drawer"]}>
    <p class="ef-eyebrow slash drawer-head">Menu</p>
    <div class="drawer-grid">
        {links.map((link) => (
            <a href={link.external ? link.url : url(link.url)}
               class="drawer-item"
               aria-current={!link.external && Astro.url.pathname === url(link.url) ? "page" : undefined}
               target={link.external ? "_blank" : null}
            >
                <span class="ef-eyebrow">{enLabel(link)}</span>
                <span class="zh" data-l="en">{link.name}</span><span class="zh" data-l="zh">{zhLabel(link)}</span>
                {link.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="ext" />}
            </a>
        ))}
    </div>
    <div class="drawer-lang">
        <LangSwitch></LangSwitch>
    </div>
</div>

<style>
    /* Phone navigation: a paper panel, a hairline frame, a 2-column grid of
       // EN over Chinese. Anchored under the top bar. */
    /* Sized by width, not by left+right: a fixed element must never be able to
       widen the page on a narrow screen. Closed = out of layout entirely. */
    .nav-drawer {
        position: fixed;
        top: calc(4.25rem + env(safe-area-inset-top, 0px));
        left: 0.75rem;
        right: auto;
        width: min(24rem, calc(100vw - 1.5rem));
        max-width: calc(100vw - 1.5rem);
        padding: 0.75rem;
        border: 1px solid var(--ef-ink);
        background: var(--ef-panel);
    }
    .nav-drawer.float-panel-closed {
        visibility: hidden;
    }
    .drawer-head {
        margin: 0 0 0.6rem;
    }
    .drawer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--ef-rule);
        border: 1px solid var(--ef-rule);
    }
    .drawer-item {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.1rem;
        min-height: 3rem;
        padding: 0.5rem 0.75rem;
        background: var(--ef-panel);
        color: var(--ef-ink);
    }
    .drawer-item:hover {
        background: var(--ef-chip);
    }
    .drawer-item[aria-current="page"] {
        background: var(--ef-signal);
        color: var(--ef-on-signal);
    }
    .drawer-item .zh {
        font-weight: 700;
        font-size: 0.9375rem;
    }
    .drawer-item .ext {
        position: absolute;
        right: 0.5rem;
        top: 0.5rem;
        width: 0.75rem;
        height: 0.75rem;
        opacity: 0.6;
    }
    .drawer-item {
        position: relative;
    }
    /* the language key sits at the bottom of the drawer on a phone */
    .drawer-lang {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--ef-rule);
    }
    .drawer-lang :global(.lang-toggle) {
        flex: 0 0 44px;
        width: 44px;
    }
</style>

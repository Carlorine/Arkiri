---
import { Icon } from "astro-icon/components";
import I18nKey from "../../i18n/i18nKey";
import UiText from "../common/UiText.astro";

interface Props {
	id: string;
	name?: string;
	nameZh?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, nameZh, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
---
<widget-layout data-id={id} data-is-collapsed={String(isCollapsed)} class:list={[className]} style={style}>
    <div class="widget ef-panel tab-right">
        <h2 class="widget-head"><span class="ef-eyebrow slash"><span data-l="en">{name}</span><span data-l="zh">{nameZh ?? name}</span></span></h2>
        <div id={id} class:list={["collapse-wrapper", { collapsed: isCollapsed }]}>
            <slot></slot>
        </div>
        {isCollapsed && <div class="expand-btn">
            <button class="ef-btn small expand" type="button">
                <Icon name="material-symbols:more-horiz" class="expand-icon"></Icon>
                <UiText k={I18nKey.more} />
            </button>
        </div>}
    </div>
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    /* the custom element is the grid item; the panel inside carries the look */
    widget-layout {
        display: block;
    }
    .widget {
        display: block;
    }
    .widget-head {
        margin: 0 0 0.5rem;
    }
    .collapse-wrapper {
        overflow: hidden;
        transition: height 180ms var(--ef-ease);
    }
    .collapse-wrapper.collapsed {
        height: var(--collapsedHeight);
    }
    .expand-btn {
        margin-top: 0.5rem;
    }
    .expand {
        width: 100%;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
    }
    .expand :global(svg) {
        font-size: 1.25rem;
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed !== "true")
                return;

            const id = this.dataset.id;
            const btn = this.querySelector('.expand-btn');
            const wrapper = this.querySelector(`#${id}`)
            btn!.addEventListener('click', () => {
                wrapper!.classList.remove('collapsed');
                btn!.classList.add('hidden');
            })
        }
    }

    if (!customElements.get("widget-layout")) {
        customElements.define("widget-layout", WidgetLayout);
    }
</script>

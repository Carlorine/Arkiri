---
import type { CollectionEntry } from "astro:content";
import { i18n } from "../i18n/translation";
import I18nKey from "../i18n/i18nKey";
import { efDate } from "../utils/post-index";
import UiText from "./common/UiText.astro";
import { uiPair } from "../utils/ui-i18n";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style?: string;
	/** No.024 — the real, stable number of this post */
	number: string;
}
const { entry, title, url, published, number, style } = Astro.props;

const { remarkPluginFrontmatter } = await entry.render();
const words = remarkPluginFrontmatter.words;
---

<li style={style}>
    <a class="ef-record" href={url} aria-label={title}>
        <span class="ef-tag">{number}</span>
        <time class="ef-field" datetime={published.toISOString()}>{efDate(published)}</time>
        <span class="name ef-read">{title}</span>
        <span class="ef-field count">{words} <UiText en={uiPair(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount).en} zh={uiPair(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount).zh} /></span>
    </a>
</li>

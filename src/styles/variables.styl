/*
 * Legacy token names, mapped onto the endfield-ui kit (src/styles/endfield.css).
 *
 * The kit's --ef-* variables are the single source of truth (light and dark are
 * two complete token sets there; the theme switches on <html class="dark">).
 * This file only keeps the legacy token names alive so components that have not
 * been rewritten yet resolve to kit values instead of a hue palette.
 *
 * There is no hue variable anymore: this style has exactly one accent, and it is a
 * fill only. Yellow is never a line or text on paper.
 */

:root
  /* the kit tokens themselves live in endfield.css; these are aliases only */
  --radius-large 0
  --content-delay 150ms

  --primary var(--ef-ink)
  --page-bg var(--ef-paper)
  --card-bg var(--ef-panel)
  --float-panel-bg var(--ef-panel)

  --btn-content var(--ef-ink)
  --btn-regular-bg var(--ef-chip)
  --btn-regular-bg-hover var(--ef-rule)
  --btn-regular-bg-active var(--ef-rule)
  --btn-plain-bg-hover var(--ef-chip)
  --btn-plain-bg-active var(--ef-rule)
  --btn-card-bg-hover var(--ef-chip)
  --btn-card-bg-active var(--ef-rule)
  --enter-btn-bg var(--ef-chip)
  --enter-btn-bg-hover var(--ef-rule)
  --enter-btn-bg-active var(--ef-rule)

  --deep-text var(--ef-ink)
  --title-active var(--ef-ink-2)

  --line-divider var(--ef-rule)
  --line-color var(--ef-rule)
  --meta-divider var(--ef-ink-2)

  --inline-code-bg var(--ef-chip)
  --inline-code-color var(--ef-ink)
  --selection-bg var(--ef-signal)
  --codeblock-selection var(--ef-mark)
  --codeblock-bg rgba(0, 0, 0, 0.05)
  --codeblock-topbar-bg rgba(0, 0, 0, 0.04)
  --codeblock-border rgba(0, 0, 0, 0.12)

  --license-block-bg var(--ef-paper)

  --link-underline var(--ef-ink-2)
  --link-hover var(--ef-ink)
  --link-active var(--ef-ink)

  --scrollbar-bg var(--ef-ink-2)
  --scrollbar-bg-hover var(--ef-ink)
  --scrollbar-bg-active var(--ef-ink)
  --scrollbar-bg-light var(--ef-ink-2)
  --scrollbar-bg-hover-light var(--ef-ink)
  --scrollbar-bg-active-light var(--ef-ink)
  --scrollbar-bg-dark var(--ef-ink-2)
  --scrollbar-bg-hover-dark var(--ef-ink)
  --scrollbar-bg-active-dark var(--ef-ink)

  --color-selection-bar var(--ef-chip)

  --display-light-icon 1
  --display-dark-icon 0

  --admonitions-color-tip var(--ef-ink)
  --admonitions-color-note var(--ef-ink)
  --admonitions-color-important var(--ef-ink)
  --admonitions-color-warning var(--ef-ink)
  --admonitions-color-caution var(--ef-ink)

  --toc-width calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-badge-bg var(--ef-chip)
  --toc-btn-hover var(--ef-chip)
  --toc-btn-active var(--ef-rule)
  --toc-item-active var(--ef-ink)

:root.dark
  --codeblock-bg rgba(255, 255, 255, 0.06)
  --codeblock-topbar-bg rgba(255, 255, 255, 0.04)
  --codeblock-border rgba(255, 255, 255, 0.14)

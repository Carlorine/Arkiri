/*
 * Admonitions and the GitHub link card.
 *
 * Admonitions are the kit's notice: a tinted plate, a yellow flag in front of
 * the title, ink text. No per-type hue, no red, no frame.
 * The GitHub card is a flat white block with square corners and ink text.
 */
.custom-md

  blockquote.admonition
    margin: 1.6em 0
    padding: 1.15rem 1.35rem
    border: 0
    background: unquote("color-mix(in srgb, var(--ef-ink) 4%, var(--ef-paper))")
    color: var(--ef-ink)
    font-style: normal

    .bdm-title
      display: flex
      align-items: center
      gap: 0.5rem
      margin-bottom: 0.6rem
      color: var(--ef-ink)
      font-family: var(--ef-font-ui)
      font-size: 0.8125rem
      font-stretch: var(--ef-wide)
      font-weight: 700
      letter-spacing: 0.06em

      &:before
        content: ''
        display: inline-block
        flex: none
        width: 0.85rem
        height: 0.85rem
        background: var(--ef-signal)

    p
      margin-block: 0.4em

  img
    border-radius: 0

  hr
    border-color: var(--ef-rule)
    border-style: solid

  iframe
    border-radius: 0
    margin-left: auto
    margin-right: auto
    max-width: 100%

a.card-github
  display: block
  position: relative
  margin: 1.5rem 0
  padding: 1.15rem 1.35rem
  border: 0
  background: var(--ef-panel)
  color: var(--ef-ink)
  border-radius: 0
  text-decoration: none
  transition: background-color 140ms var(--ef-ease)

  &:hover
    background: var(--ef-chip)

  .gc-titlebar
    display: flex
    align-items: center
    justify-content: space-between
    gap: 1rem
    margin-bottom: 0.5rem
    font-family: var(--ef-font-ui)
    font-size: 1rem
    font-weight: 700
    color: var(--ef-ink)

  .gc-titlebar-left
    display: flex
    align-items: center
    min-width: 0

  .gc-owner
    display: flex
    align-items: center
    gap: 0.25rem
    min-width: 0

  .gc-user
    color: var(--ef-ink-2)
    font-weight: 600

  .gc-divider
    margin: 0 0.25rem
    color: var(--ef-rule)

  .gc-repo
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

  .github-logo
    flex: none
    width: 1.1rem
    height: 1.1rem

  .gc-description
    margin: 0.35rem 0 0.7rem
    color: var(--ef-ink-2)
    font-size: 0.875rem
    line-height: 1.6

  .gc-infobar
    display: flex
    flex-wrap: wrap
    gap: 1rem
    color: var(--ef-ink-2)
    font-family: var(--ef-font-ui)
    font-size: 0.8125rem
    font-stretch: var(--ef-wide)
    font-variant-numeric: tabular-nums

  .gc-avatar
    display: none

  &.fetch-waiting
    pointer-events: none
    opacity: 0.6

  &.fetch-error
    border-color: var(--ef-ink)
